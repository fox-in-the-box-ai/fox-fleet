# Required — set these before running docker compose up
FOX_ADMIN_SECRET=change-me-to-a-strong-secret
FOX_INSTANCE_PASSWORD=change-me-to-a-strong-password

# Your domain — wildcard DNS (*.domain) must point to this server
DOMAIN=fleet.example.com

# Docker socket GID — run: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
