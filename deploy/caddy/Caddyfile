# Fox Fleet — Caddy reverse proxy with automatic TLS.
#
# Replace {$DOMAIN} with your domain (e.g. fleet.example.com) or set it
# as an environment variable. Caddy obtains and renews TLS certificates
# automatically via Let's Encrypt.
#
# Panel:     https://{$DOMAIN}        → fox-control :9090
# Data API:  https://{$DOMAIN}/v1/*   → data plane  :9091
# Instances: https://*.{$DOMAIN}      → fox-control :9090 (subdomain proxy)
#
# Instance routing is subdomain-based: each user's Fox instance is
# accessible at <username>.{$DOMAIN}. The fox-control panel handles
# subdomain dispatch, session auth, and reverse-proxying to the
# instance's allocated port.

{
	# Uncomment for staging certificates during testing:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	on_demand_tls {
		ask http://localhost:9090/cloud/tls-check
		# Caddy sends ?domain=<requested-domain> to this endpoint.
		# 200 = issue certificate; non-2xx = reject.
		# The endpoint validates: domain suffix, no nested subdomain,
		# user exists, instance assigned.
	}
}

# Panel + data plane (base domain)
{$DOMAIN} {
	# Data plane API (must be before the catch-all reverse_proxy)
	handle /v1/* {
		reverse_proxy localhost:9091
	}

	# Health probe (unauthenticated)
	handle /healthz {
		reverse_proxy localhost:9090
	}

	# Panel (UI + management API + cloud login)
	handle {
		reverse_proxy localhost:9090
	}
}

# Instance subdomains — *.{$DOMAIN} routes through fox-control's
# subdomain proxy. Fox-control resolves the subdomain slug to a user,
# verifies the session cookie, and reverse-proxies to the instance.
*.{$DOMAIN} {
	tls {
		on_demand
	}

	reverse_proxy localhost:9090
}
