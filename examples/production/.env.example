# Required — generate strong values before first run.
#
#   openssl rand -hex 24   (for admin secret)
#   openssl rand -hex 16   (for instance password)
#
FOX_ADMIN_SECRET=
FOX_INSTANCE_PASSWORD=

# Optional — override the fox-control image tag.
# FOX_VERSION=latest

# Optional — webhook HMAC signing secret.
# FOX_WEBHOOK_SECRET=

# Optional — API key for embedding providers that require one.
# EMBEDDING_API_KEY=
